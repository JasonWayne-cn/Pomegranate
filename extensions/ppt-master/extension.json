{
  "schemaVersion": 1,
  "apiVersion": 1,
  "protocolVersion": 1,
  "id": "ppt-master",
  "name": "PPT Master 生成引擎",
  "version": "1.2.1",
  "kind": "ppt-engine",
  "minAppVersion": "2.1.0",
  "platforms": ["windows-x86_64"],
  "runtime": {
    "type": "python-script",
    "entry": "entry.py",
    "protocol": "jsonl-stdio",
    "python": {
      "min": "3.8",
      "max": "3.13",
      "path": ""
    }
  },
  "permissions": [
    "docs:read-selected",
    "fs:write-job",
    "process:spawn",
    "net:ai-host-proxy"
  ],
  "contributes": {
    "ppt": {
      "layoutsIndex": "templates/layouts/layouts_index.json",
      "chartsIndex": "templates/charts/charts_index.json"
    }
  },
  "integrity": {
    "sha256": null,
    "signature": null
  }
}
