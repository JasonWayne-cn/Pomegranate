# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# 扩展包构建中间目录与 Python 缓存
build/
__pycache__/
*.pyc

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Tauri signing keys (NEVER commit private keys)
src-tauri/keys/

# WebView2 Fixed Version 109 runtime (~250MB, not for git)
# Download manually from:
#   https://www.nuget.org/packages/Microsoft.Web.WebView2/109.0.1518.78
#   or https://github.com/thecosmicfrog/WebView2Samples/releases
# Extract to: src-tauri/WebView2-FixedRuntime-109/
src-tauri/WebView2-FixedRuntime-109/

# Release config (contains local paths)
.claude/release-config.json

# C 编译产物（MSVC .obj 文件）
*.obj

# 设计稿/原型/临时输出（不进仓库）
output/

# B 站调试产物（本地保留，不进任何远程仓库）
bili_*.json
.claude/scheduled_tasks.lock

# 合并过程产物（三方合并脚本输出）
*.merged

# 工具生成的图谱/分析产物（可随时重建）
.understand-anything/
graphify-out/

# Excalidraw 字体（vite.config.ts 构建时从 node_modules 自动同步）
public/excalidraw/fonts/

# npm 误生成的锁文件（本项目使用 pnpm）
package-lock.json

# 打包的第三方可执行文件（体积超 GitHub 100MB 限制）
src/components/editor/*.exe

# 本地 ASR 模型缓存（约 254MB，运行时下载/放置，不进仓库）
voice-model/

# 临时测试/截图产物
.tmp-office-test/
.tmp_svg$n.png
